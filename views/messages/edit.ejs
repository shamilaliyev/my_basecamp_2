<%- include("../partials/header", { pageTitle }) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-4">
        <p class="text-secondary mb-1">Thread: <%= thread.title %></p>
        <h1 class="h3 mb-3">Edit Message</h1>

        <form action="/projects/<%= project.id %>/threads/<%= thread.id %>/messages/<%= message.id %>?_method=PUT" method="POST">
          <div class="mb-3">
            <label class="form-label" for="content">Message</label>
            <textarea class="form-control" id="content" name="content" rows="6" required><%= message.content %></textarea>
          </div>

          <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save Message</button>
            <a href="/projects/<%= project.id %>/threads/<%= thread.id %>" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
